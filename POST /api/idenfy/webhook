// /api/idenfy/webhook.js
let memoryStore = new Map(); // replace with Redis/DB in production

export default async function handler(req, res) {
  try {
    const event = req.body; // ensure body parsing enabled
    // iDenfy sends verification result events here; you can configure
    // one final webhook or separate automated/manual review webhooks. :contentReference[oaicite:9]{index=9}

    const scanRef   = event?.scanRef;
    const clientId  = event?.clientId || event?.personScanRef;
    const status    = (event?.overall || '').toLowerCase(); // e.g., APPROVED/REJECTED/SUSPECTED

    // Persist for front-end polling:
    if (scanRef) memoryStore.set(scanRef, status);

    // Update HubSpot contact by clientId (you saved it in the form)
    if (clientId) {
      await fetch(`https://api.hubapi.com/crm/v3/objects/contacts/search`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${process.env.HUBSPOT_PRIVATE_APP_TOKEN}`
        },
        body: JSON.stringify({
          filterGroups: [{filters:[{propertyName:"kyc_client_id", operator:"EQ", value: clientId}]}],
          properties: ["email"]
        })
      }).then(r => r.json()).then(async search => {
        const vid = search?.results?.[0]?.id;
        if (vid) {
          await fetch(`https://api.hubapi.com/crm/v3/objects/contacts/${vid}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${process.env.HUBSPOT_PRIVATE_APP_TOKEN}`
            },
            body: JSON.stringify({ properties: { kyc_status: status } })
          });
        }
      });
    }

    res.status(200).json({ ok: true });
  } catch (e) {
    res.status(200).json({ ok: false, note: 'return 2xx so iDenfy does not retry excessively' });
  }
}
